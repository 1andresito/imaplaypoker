{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "imaplaypoker",
  "version": "0.6.0",
  "identifier": "com.andresito.imaplaypoker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "imaplaypoker",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "CardGame",
    "shortDescription": "Learn poker by playing it",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1MDZCRTYwN0U4NzZERUMKUldUc2JZZCtZTDRHUll4NzdnL2NCNmM5VlU5bUtWenljck51OWZHNE5tVnE0YVowV2wreDZYYzgK",
      "endpoints": [
        "https://github.com/1andresito/imaplaypoker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
